# Maintainer: Open Image Blender contributors
# Local build: run `makepkg -f` in this directory from a checkout of the repo.
# For an AUR submission, replace the local copy in package() with a git source.
pkgname=openimageblender
pkgver=0.1.0
pkgrel=7
pkgdesc="Turn an image into a 3D scene"
arch=('any')
url="https://github.com/openimageblender/openimageblender"
license=('MIT')
depends=('python' 'pyside6' 'python-pillow' 'python-numpy' 'python-requests' 'blender' 'uv')
source=()
sha256sums=()

package() {
  local root="$startdir/.."
  install -dm755 "$pkgdir/usr/lib/$pkgname"
  cp -a "$root/src" "$pkgdir/usr/lib/$pkgname/src"
  find "$pkgdir/usr/lib/$pkgname" -name __pycache__ -type d -exec rm -rf {} + 2>/dev/null || true
  install -Dm755 "$startdir/openimageblender.sh" "$pkgdir/usr/bin/openimageblender"
  install -Dm644 "$startdir/openimageblender.desktop" \
    "$pkgdir/usr/share/applications/openimageblender.desktop"
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
